# Neon PostgreSQL — projet Neon dédié à la plateforme Gestion d'Atelier
# Connexion POOLÉE (hostname avec "-pooler") — utilisée par le runtime (Prisma Client / adapter-pg)
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.neon.tech/<db>?sslmode=require&pgbouncer=true&connection_limit=1"

# Connexion DIRECTE (sans "-pooler") — utilisée uniquement par la CLI Prisma (migrate deploy/dev)
DIRECT_URL="postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require"

# Authentification
JWT_SECRET="genere-une-valeur-aleatoire-longue-avant-le-premier-deploiement"

# Amorçage du premier compte ADMIN, rattaché à l'atelier existant (npm run
# prisma:seed) — dev/premier déploiement uniquement.
SEED_ADMIN_IDENTIFIANT="admin"
SEED_ADMIN_PASSWORD="choisis-un-mot-de-passe-fort"

# Amorçage du compte SUPERADMIN de la plateforme (npm run prisma:seed:superadmin,
# Phase 8) — n'appartient à aucun atelier, administre tous les tenants.
SEED_SUPERADMIN_IDENTIFIANT="superadmin"
SEED_SUPERADMIN_PASSWORD="choisis-un-mot-de-passe-fort"

# Vercel Blob (upload logo atelier / photos modèles / justificatifs dépenses)
BLOB_READ_WRITE_TOKEN="token-fourni-par-vercel-quand-le-store-blob-est-cree"

# Abonnement — paiement Wave (Phase 6, voir backend/src/lib/wave.js).
# WAVE_API_KEY : clé "Bearer" du Wave Business Portal (production).
# WAVE_WEBHOOK_SECRET : secret fourni par Wave à l'enregistrement de l'URL
# webhook (préfixe "wave_sn_WHS_..."), sert à vérifier la signature
# Wave-Signature — sans lui, /api/webhooks/wave refuse tout (503), jamais de
# confirmation de paiement sans vérification. Tant que ces deux valeurs ne
# sont pas définies, les paiements Wave échouent explicitement (502) : aucune
# simulation.
WAVE_API_KEY="cle-wave-business-a-obtenir-sur-le-portail-wave"
WAVE_WEBHOOK_SECRET="secret-webhook-wave-a-obtenir-a-l-enregistrement-de-l-url"

# Développement local uniquement
PORT=4000
NODE_ENV=development
