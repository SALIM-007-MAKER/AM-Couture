# Neon PostgreSQL — projet Neon dédié à la plateforme Gestion d'Atelier
# Connexion POOLÉE (hostname avec "-pooler") — utilisée par le runtime (Prisma Client / adapter-pg)
DATABASE_URL="postgresql://<user>:<password>@<host>-pooler.neon.tech/<db>?sslmode=require&pgbouncer=true&connection_limit=1"

# Connexion DIRECTE (sans "-pooler") — utilisée uniquement par la CLI Prisma (migrate deploy/dev)
DIRECT_URL="postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require"

# Authentification
JWT_SECRET="genere-une-valeur-aleatoire-longue-avant-le-premier-deploiement"

# Amorçage du premier compte ADMIN, rattaché à l'atelier existant (npm run
# prisma:seed) — dev/premier déploiement uniquement.
SEED_ADMIN_IDENTIFIANT="admin"
SEED_ADMIN_PASSWORD="choisis-un-mot-de-passe-fort"

# Amorçage du compte SUPERADMIN de la plateforme (npm run prisma:seed:superadmin,
# Phase 8) — n'appartient à aucun atelier, administre tous les tenants.
SEED_SUPERADMIN_IDENTIFIANT="superadmin"
SEED_SUPERADMIN_PASSWORD="choisis-un-mot-de-passe-fort"

# Vercel Blob (upload logo atelier / photos modèles / justificatifs dépenses)
BLOB_READ_WRITE_TOKEN="token-fourni-par-vercel-quand-le-store-blob-est-cree"

# Abonnement — AUCUN paiement en ligne pour l'instant : les abonnements sont
# activés manuellement par le SUPERADMIN (panneau SuperAdmin > fiche atelier).
# Les variables ci-dessous sont RÉSERVÉES au futur paiement en ligne (couche
# dormante backend/src/lib/payments/, webhooks non montés) — non lues tant
# qu'aucune intégration n'est branchée. Jamais dans le frontend ni dans le dépôt.
WAVE_API_KEY=""
WAVE_WEBHOOK_SECRET=""
NITA_API_KEY=""
AMANATA_API_KEY=""

# Envoi d'email — Resend (Phase 8 suite : vérification d'email à
# l'inscription + réinitialisation de mot de passe en libre-service, voir
# backend/src/lib/resend.js). Tant que RESEND_API_KEY n'est pas définie,
# tout envoi échoue explicitement (best effort à l'inscription, 502 sur une
# demande explicite de renvoi) : aucune simulation.
RESEND_API_KEY="cle-api-a-obtenir-sur-resend.com"
# Optionnel — remplace le domaine de test partagé de Resend
# (onboarding@resend.dev) une fois un domaine propre vérifié sur Resend.
RESEND_FROM_EMAIL="Gestion d'Atelier <onboarding@resend.dev>"

# Rappels automatiques quotidiens (voir backend/src/routes/cron.routes.js,
# déclenchée par Vercel Cron — vercel.json) : commandes en retard, prêtes,
# livraison proche, impayées, envoyées par email via Resend (ci-dessus).
# Vercel envoie automatiquement `Authorization: Bearer $CRON_SECRET` quand
# cette variable est définie sur le projet — sans elle, la route répond 503
# (désactivée), jamais un envoi non authentifié.
CRON_SECRET="genere-une-valeur-aleatoire-longue"

# Développement local uniquement
PORT=4000
NODE_ENV=development
