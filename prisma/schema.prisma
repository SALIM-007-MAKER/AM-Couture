// GESTION D'ATELIER — Schéma de données (plateforme multi-atelier ; "AM
// Couture" est le premier atelier/tenant enregistré, pas le nom de l'app).
// Prisma ORM v7 — generator "prisma-client" + adapter obligatoire (voir backend/src/lib/prisma.js)

generator client {
  provider = "prisma-client"
  output   = "../backend/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Pas d'url ici : la connexion runtime passe par l'adapter (@prisma/adapter-pg),
  // et la connexion CLI/migrations est définie dans prisma.config.ts (DIRECT_URL).
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum Sexe {
  FEMME
  HOMME
  AUTRE
}

enum StatutCommande {
  NOUVELLE
  EN_CONFECTION
  ESSAYAGE
  RETOUCHES
  TERMINEE
  LIVREE
  ANNULEE
}

enum Priorite {
  NORMALE
  URGENTE
}

enum ModePaiement {
  ESPECES
  MOBILE_MONEY
  VIREMENT
  AUTRE
}

enum CategorieVetement {
  ROBE
  BOUBOU
  ENSEMBLE
  PANTALON
  CHEMISE
  JUPE
  KAFTAN
  COSTUME
  TENUE_TRADITIONNELLE
  AUTRE
}

// Abonnement (Phase 6) : accès de l'atelier à la plateforme Gestion d'Atelier
// elle-même (pas un produit vendu par l'atelier à ses clientes). EN_ATTENTE
// = créé, aucun paiement réussi ; CONFIRME = au moins un paiement réussi
// l'a activé — "actif" vs "expiré" se DÉRIVENT de dateExpiration à la
// lecture (jamais stockés), même principe que statutPaiement (money.js).
// ANNULE = annulation explicite. Aucun blocage d'accès dans cette phase.
enum StatutAbonnement {
  EN_ATTENTE
  CONFIRME
  ANNULE
}

// Valeur AMANA conservée telle quelle (historique) même si le prestataire est
// parfois désigné "Amanata" — voir AmanataPaymentProvider (lib/payments/) :
// renommer une valeur d'enum déjà utilisée en base serait une migration
// destructive pour un simple changement de libellé, aucun bénéfice réel.
enum MoyenPaiement {
  WAVE
  NITA
  AMANA
}

// pending/paid/failed/cancelled/expired (§ architecture paiement abonnement)
// — noms français pour rester cohérent avec le reste du schéma (voir
// StatutCommande, StatutDemandeCommande...), jamais un mélange FR/EN dans les
// enums Prisma. EN_ATTENTE = pending, REUSSIE = paid, ECHOUEE = failed
// (référence invalide/rejetée), ANNULEE = cancelled (paiement abandonné
// avant complétion, ex: session Wave fermée sans payer), EXPIREE = expired
// (fenêtre de paiement dépassée sans action, ex: session Wave expirée) —
// distinction utile pour l'audit/support, même si l'effet sur l'abonnement
// est identique (aucune activation).
enum StatutTransaction {
  EN_ATTENTE
  REUSSIE
  ECHOUEE
  ANNULEE
  EXPIREE
}

// Historique des changements d'abonnement d'un atelier (§ abonnement géré
// manuellement par le SUPERADMIN) — une ligne par action, jamais modifiée.
enum ActionAbonnement {
  ACTIVATION
  MODIFICATION
  EXPIRATION
  DESACTIVATION
}

// Multi-tenant (Phase 8) — plateforme "Gestion d'Atelier" : SUPERADMIN gère
// toute la plateforme (aucun atelierId, voir User ci-dessous) ; ADMIN
// appartient à exactement un atelier et n'accède qu'à ses propres données
// (cloisonnement appliqué côté backend, voir lib/scopeAtelier.js). USER
// (§ plan rôle client, Phase 3) : un client final, TOUJOURS rattaché à un
// atelier ET à exactement une Cliente (voir Cliente.userId ci-dessous) —
// n'accède jamais aux données d'un autre client, même au sein du même
// atelier (filtrage par clienteId, pas seulement atelierId — voir
// middlewares/auth.middleware.js:requireClient).
enum RoleUtilisateur {
  SUPERADMIN
  ADMIN
  USER
}

// ─────────────────────────────────────────────────────────────────────────
// Utilisateurs et ateliers (tenants)
// ─────────────────────────────────────────────────────────────────────────

model User {
  id                  String          @id @default(cuid())
  identifiant         String          @unique
  passwordHash        String
  // Identité de la personne (Phase 8 — inscription en libre-service, voir
  // auth.routes.js POST /inscription-atelier) — optionnels car les comptes
  // créés avant cette phase (ex: le seed "admin") n'en ont pas ; jamais
  // utilisés pour la connexion, qui reste basée sur `identifiant` uniquement.
  prenom              String?
  nom                 String?
  email               String?         @unique
  // Préférence stockée uniquement (Phase 6) : aucune infrastructure i18n,
  // l'interface reste 100% en français pour l'instant — voir constants.js
  // frontend pour la liste des valeurs acceptées.
  langue              String          @default("fr")
  role                RoleUtilisateur @default(ADMIN)
  // null UNIQUEMENT pour SUPERADMIN — un ADMIN doit toujours appartenir à un
  // atelier (contrainte applicative vérifiée au login/à la création, voir
  // auth.routes.js/ateliers.routes.js ; pas de contrainte CHECK SQL native
  // pour ce genre de règle croisée avec Prisma).
  atelierId           String?
  atelier             Atelier?        @relation(fields: [atelierId], references: [id], onDelete: Restrict)
  createdAt           DateTime        @default(now())
  // Mis à jour à chaque connexion réussie (voir POST /auth/login) — sert
  // uniquement à l'affichage (fiche atelier côté SUPERADMIN), jamais à une
  // décision d'autorisation.
  derniereConnexionAt DateTime?
  // null tant que le lien envoyé par email (voir POST /auth/inscription-atelier)
  // n'a pas été cliqué — jamais une condition bloquante pour se connecter ou
  // utiliser l'application (voir décision : accès immédiat après inscription),
  // juste une information affichée (bannière de rappel côté frontend).
  emailVerifieLe      DateTime?
  // Incrémenté à CHAQUE changement de mot de passe (self-service, mot de
  // passe oublié, ou réinitialisation par le SUPERADMIN) — embarqué dans le
  // JWT à sa signature (voir jwt.js) et revérifié à chaque requête (voir
  // requireAuth, auth.middleware.js) : un jeton signé avec un ancien
  // sessionVersion est rejeté, même s'il n'est pas encore expiré (7 jours).
  // Sans ça, changer son mot de passe ne déconnectait aucune AUTRE session
  // déjà ouverte ailleurs (un JWT reste valide par nature jusqu'à son
  // expiration, quoi qu'il arrive côté base).
  sessionVersion      Int             @default(0)

  tokensAction TokenAction[]
  // Présent UNIQUEMENT pour un compte USER (voir Cliente.userId) — null pour
  // ADMIN/SUPERADMIN, qui ne sont jamais reliés à une Cliente.
  cliente      Cliente?      @relation

  @@index([atelierId])
}

enum TypeTokenAction {
  VERIFICATION_EMAIL
  REINITIALISATION_MOT_DE_PASSE
  // Invitation d'un client final (§ plan rôle USER) — voir
  // clientes.routes.js POST /:id/inviter. Le User (role USER) et le lien
  // Cliente.userId sont créés IMMÉDIATEMENT à l'invitation (avec un
  // passwordHash temporaire et inutilisable) ; ce jeton sert uniquement à
  // laisser le client choisir son VRAI mot de passe pour activer l'accès.
  INVITATION_CLIENT
}

// Jetons à usage unique envoyés par email (Resend, voir lib/resend.js) —
// vérification d'email à l'inscription et réinitialisation de mot de passe
// en libre-service. onDelete: Cascade (SEUL endroit du schéma à utiliser
// Cascade plutôt que Restrict) : un jeton est une donnée strictement
// éphémère et dérivée, sans valeur propre une fois l'utilisateur supprimé —
// contrairement aux données métier (Commande, Paiement...) qu'on protège
// délibérément d'une suppression en cascade silencieuse.
model TokenAction {
  id        String          @id @default(cuid())
  token     String          @unique
  type      TypeTokenAction
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  expireLe  DateTime
  utiliseLe DateTime?
  createdAt DateTime        @default(now())

  @@index([userId])
}

/// Un atelier = un tenant de la plateforme. Chaque atelier a son propre nom,
/// logo, coordonnées, comptes ADMIN et données métier (Clientes, Commandes,
/// Modèles, Dépenses, Abonnement) — jamais partagés entre ateliers.
model Atelier {
  id          String    @id @default(cuid())
  nom         String
  logoUrl     String?
  telephone   String?
  adresse     String?
  // Distincts d'`adresse` (rue/complément, en texte libre) — ajoutés pour
  // l'inscription en libre-service (Phase 8), qui les demande séparément.
  ville       String?
  pays        String?
  slogan      String?
  devise      String    @default("FCFA")
  recuConfig  Json?
  // Suspension par le SUPERADMIN (ex: impayé, litige) — bloque IMMÉDIATEMENT
  // les nouvelles requêtes de tout compte de cet atelier (vérifié à chaque
  // requête via requireAtelier, pas seulement à la connexion : voir
  // auth.middleware.js), sans supprimer aucune donnée.
  actif       Boolean   @default(true)
  suspenduLe  DateTime?
  // Essai gratuit de 7 jours — posé UNE SEULE FOIS à la création (voir
  // atelierProvisioning.js:creerAtelierEtAdmin), jamais recalculé ni
  // prolongé après coup, jamais accepté depuis le frontend. `null` pour
  // tout atelier créé AVANT l'introduction de cette fonctionnalité : ces
  // ateliers "légataires" ne sont jamais bloqués par le trial (voir
  // lib/trial.js) — seuls les ateliers créés après ont une échéance réelle.
  trialEndsAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users                User[]
  clientes             Cliente[]
  modeles              Modele[]
  commandes            Commande[]
  depenses             Depense[]
  articlesStock        ArticleStock[]
  abonnements          Abonnement[]
  historiqueAbonnement HistoriqueAbonnement[]
  demandesCommande     DemandeCommande[]
}

// ─────────────────────────────────────────────────────────────────────────
// Clientes / Mesures / Modèles
// ─────────────────────────────────────────────────────────────────────────

model Cliente {
  id         String    @id @default(cuid())
  atelierId  String
  atelier    Atelier   @relation(fields: [atelierId], references: [id], onDelete: Restrict)
  nom        String
  prenom     String
  telephone  String
  telephone2 String?
  // Optionnel — sert UNIQUEMENT à l'envoi automatique du lien d'invitation
  // (voir POST /clientes/:id/inviter) : l'identifiant de connexion du compte
  // USER reste le téléphone, jamais cet email (pas d'unicité imposée ici).
  email      String?
  adresse    String?
  sexe       Sexe?
  notes      String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Lien OPTIONNEL vers un compte de connexion (§ plan rôle USER, Phase 3) —
  // Cliente reste l'unique source de vérité métier, User n'est qu'un MOYEN
  // DE CONNEXION greffé dessus : une Cliente peut exister indéfiniment sans
  // jamais avoir de compte (client géré uniquement par l'atelier). Créé par
  // l'invitation ADMIN (voir clientes.routes.js POST /:id/inviter), jamais
  // par auto-inscription. onDelete: SetNull (déroge à la convention Restrict
  // du reste du schéma) : supprimer le compte de connexion ne doit JAMAIS
  // faire perdre la moindre donnée métier — la Cliente redevient simplement
  // "sans compte", son état le plus courant.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  mesures             Mesure[]
  commandes           Commande[]
  demandesCommande    DemandeCommande[]
  notificationsClient NotificationClient[]

  @@index([atelierId])
  @@index([nom, prenom])
  @@index([telephone])
}

model Mesure {
  id        String  @id @default(cuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  epaule           Decimal? @db.Decimal(6, 2)
  poitrine         Decimal? @db.Decimal(6, 2)
  taille           Decimal? @db.Decimal(6, 2)
  hanches          Decimal? @db.Decimal(6, 2)
  longueur         Decimal? @db.Decimal(6, 2)
  longueurRobe     Decimal? @db.Decimal(6, 2)
  longueurJupe     Decimal? @db.Decimal(6, 2)
  longueurPantalon Decimal? @db.Decimal(6, 2)
  longueurManche   Decimal? @db.Decimal(6, 2)
  tourBras         Decimal? @db.Decimal(6, 2)
  tourCou          Decimal? @db.Decimal(6, 2)
  tourPoignet      Decimal? @db.Decimal(6, 2)
  tourCuisse       Decimal? @db.Decimal(6, 2)
  tourGenou        Decimal? @db.Decimal(6, 2)
  autres           Json? // mesures libres additionnelles : { "label": valeur }

  notes     String?
  createdAt DateTime @default(now())

  @@index([clienteId])
}

model Modele {
  id            String            @id @default(cuid())
  atelierId     String
  atelier       Atelier           @relation(fields: [atelierId], references: [id], onDelete: Restrict)
  nom           String
  categorie     CategorieVetement
  description   String?
  prixIndicatif Decimal?          @db.Decimal(10, 2)
  photoUrl      String?
  archivedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  commandes        Commande[]
  demandesCommande DemandeCommande[]

  @@index([atelierId])
  @@index([nom])
}

// ─────────────────────────────────────────────────────────────────────────
// Commandes / Paiements / Livraisons / Reçus
// ─────────────────────────────────────────────────────────────────────────

model Commande {
  id        String  @id @default(cuid())
  atelierId String
  atelier   Atelier @relation(fields: [atelierId], references: [id], onDelete: Restrict)
  numero    String  @unique // CMD-2026-0001, généré atomiquement — voir Counter (numérotation globale à la plateforme, pas par atelier — voir note de simplification)
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  modeleId  String?
  modele    Modele? @relation(fields: [modeleId], references: [id], onDelete: SetNull)

  typeVetement CategorieVetement
  description  String?
  couleur      String?
  tissu        String?
  quantite     Int               @default(1)
  prixTotal    Decimal           @db.Decimal(10, 2)
  // Pas de champ "acompte" ici : le premier versement est enregistré comme un
  // Paiement normal (créé en transaction à la création de la commande). Le
  // solde est TOUJOURS dérivé de prixTotal - SUM(paiements.montant), jamais stocké.

  statut   StatutCommande @default(NOUVELLE)
  priorite Priorite       @default(NORMALE)

  dateCommande        DateTime @default(now())
  dateLivraisonPrevue DateTime
  observations        String?

  // Photos (Phase 2) : mêmes conventions que Modele.photoUrl / Atelier.logoUrl
  // — data URL base64 stockée telle quelle (voir optionalImageField), pas de
  // service de stockage externe. photoTissuUrl = échantillon du tissu choisi,
  // photoModeleUrl = photo du modèle/design souhaité par la cliente.
  photoTissuUrl  String?
  photoModeleUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paiements           Paiement[]
  // Livraison[] (et non Livraison? comme avant) : une livraison peut être
  // annulée (annuleAt) pour cause d'erreur de saisie, auquel cas une
  // nouvelle doit pouvoir être enregistrée pour la même commande — un
  // Livraison? unique en base l'aurait interdit à vie. "La" livraison
  // active (au plus une à la fois, contrainte partielle en base, voir
  // migration) se retrouve par livraisons.find(l => !l.annuleAt).
  livraisons          Livraison[]
  recus               Recu[]
  notifications       Notification[]
  // Présente UNIQUEMENT si cette commande est née d'une demande envoyée par
  // le client (§ plan rôle USER) — voir DemandeCommande.commandeId.
  demandeOrigine      DemandeCommande?
  notificationsClient NotificationClient[]

  // atelierId : index déjà présent en base depuis la migration Phase 8
  // (20260913051222_multi_tenant_ateliers, ajouté en SQL brut) mais jusqu'ici
  // non déclaré ici — corrigé au passage pour que `prisma migrate dev` cesse
  // de vouloir le supprimer (schema.prisma doit refléter l'état réel de la
  // base, jamais l'inverse).
  @@index([atelierId])
  @@index([clienteId])
  @@index([statut])
  @@index([dateLivraisonPrevue])
}

// ─────────────────────────────────────────────────────────────────────────
// Demande de commande (§ plan rôle USER, Phase 3) — un client final PROPOSE,
// l'ADMIN DÉCIDE. Jamais de création directe de Commande par un USER : le
// prix, le modèle final, les dates restent entièrement sous le contrôle de
// l'atelier, qui transforme (ou refuse) la demande en une vraie Commande.
// ─────────────────────────────────────────────────────────────────────────

enum StatutDemandeCommande {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}

model DemandeCommande {
  id        String  @id @default(cuid())
  atelierId String
  atelier   Atelier @relation(fields: [atelierId], references: [id], onDelete: Restrict)
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  modeleId  String?
  modele    Modele? @relation(fields: [modeleId], references: [id], onDelete: SetNull)

  description String?

  statut     StatutDemandeCommande @default(EN_ATTENTE)
  motifRefus String?

  // Posé UNIQUEMENT quand l'ADMIN accepte la demande — la Commande créée à
  // ce moment-là est la seule trace formelle de l'engagement (prix, dates),
  // jamais devinée depuis la demande elle-même.
  commandeId String?   @unique
  commande   Commande? @relation(fields: [commandeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([atelierId])
  @@index([clienteId])
  @@index([statut])
}

model Paiement {
  id          String       @id @default(cuid())
  commandeId  String
  commande    Commande     @relation(fields: [commandeId], references: [id], onDelete: Restrict)
  montant     Decimal      @db.Decimal(10, 2)
  date        DateTime     @default(now())
  mode        ModePaiement
  reference   String?
  commentaire String?
  createdAt   DateTime     @default(now())

  // Annulation logique d'une erreur de saisie — jamais de modification ni de
  // suppression de la ligne d'origine (voir POST .../paiements/:id/annuler).
  // Un paiement annulé reste visible dans l'historique mais est exclu de
  // tous les totaux (solde, statistiques, rapports).
  annuleAt    DateTime?
  annuleMotif String?

  recu Recu?

  @@index([commandeId])
  @@index([date])
}

model Livraison {
  id             String   @id @default(cuid())
  commandeId     String
  commande       Commande @relation(fields: [commandeId], references: [id], onDelete: Restrict)
  dateLivraison  DateTime @default(now())
  montantRestant Decimal  @db.Decimal(10, 2) // snapshot calculé côté serveur, jamais accepté depuis le client
  commentaire    String?
  createdAt      DateTime @default(now())

  // Annulation logique — mêmes principes que Paiement.annuleAt ci-dessus.
  // Pas de @@unique([commandeId]) : une commande peut avoir plusieurs lignes
  // Livraison dans le temps (une annulée + une nouvelle correcte), mais au
  // plus UNE active (annuleAt IS NULL) — contrainte partielle ajoutée à la
  // main dans la migration SQL (Prisma ne supporte pas les index uniques
  // partiels dans son DSL de schéma), backstop en base en plus de la
  // vérification applicative (voir routes/livraisons.routes.js).
  annuleAt    DateTime?
  annuleMotif String?

  @@index([commandeId])
}

model Recu {
  id          String    @id @default(cuid())
  numero      String    @unique // REC-2026-0001, généré atomiquement — voir Counter
  commandeId  String
  commande    Commande  @relation(fields: [commandeId], references: [id], onDelete: Restrict)
  paiementId  String?   @unique
  paiement    Paiement? @relation(fields: [paiementId], references: [id], onDelete: Restrict)
  montantPaye Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())
}

enum NotificationType {
  RETARD // dateLivraisonPrevue dépassée, statut non terminal
  PRET // statut = TERMINEE (prête à récupérer, pas encore livrée)
  LIVRAISON_PROCHE // dateLivraisonPrevue dans les prochains jours (voir lib/notifications.js)
  IMPAYE // 0 FCFA encaissé, hors ANNULEE
}

/// Contenu volontairement minimal : AUCUN texte/libellé stocké — le message
/// affiché est reconstruit à la lecture depuis la Commande/Cliente réelles
/// (voir lib/notifications.js), même principe que le reste du projet (rien
/// de calculable n'est stocké en dur). Cette table ne retient que l'état qui
/// NE PEUT PAS être recalculé : "cette alerte a-t-elle été lue ?".
///
/// Réconciliée à chaque GET /api/notifications (pas de tâche planifiée) :
/// une ligne est créée (non lue) dès qu'une condition devient vraie, et
/// supprimée automatiquement dès qu'elle ne l'est plus (commande livrée,
/// payée...). @@unique évite les doublons lors de cette réconciliation.
model Notification {
  id         String           @id @default(cuid())
  type       NotificationType
  commandeId String
  commande   Commande         @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  lu         Boolean          @default(false)
  createdAt  DateTime         @default(now())

  @@unique([type, commandeId])
  @@index([lu])
}

enum TypeNotificationClient {
  COMMANDE_CREEE
  COMMANDE_STATUT_CHANGE
  COMMANDE_ANNULEE
  PAIEMENT_ENREGISTRE
  LIVRAISON_ENREGISTREE
  RECU_EMIS
  DEMANDE_ACCEPTEE
  DEMANDE_REFUSEE
}

/// Fil d'activité du CLIENT final (§ notifications atelier <-> client) —
/// délibérément un modèle SÉPARÉ de Notification ci-dessus, pas une
/// extension : Notification reflète un ÉTAT recalculable à tout moment
/// (jamais de texte stocké, voir son commentaire) — mais "5000 FCFA
/// encaissés le 18/09" ou "refusée : motif X" sont des ÉVÉNEMENTS ponctuels,
/// impossibles à reconstituer depuis l'état courant une fois qu'un autre
/// paiement est venu s'ajouter. `message` est donc figé à la création,
/// jamais recalculé — seul cas du schéma où un texte de notification est
/// stocké tel quel. `lu` ici n'a aucun rapport avec Notification.lu (compte
/// ADMIN) : deux publics, deux drapeaux de lecture indépendants sur la même
/// commande.
model NotificationClient {
  id         String                 @id @default(cuid())
  clienteId  String
  cliente    Cliente                @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  commandeId String?
  commande   Commande?              @relation(fields: [commandeId], references: [id], onDelete: SetNull)
  type       TypeNotificationClient
  message    String
  lu         Boolean                @default(false)
  createdAt  DateTime               @default(now())

  @@index([clienteId])
  @@index([lu])
}

// ─────────────────────────────────────────────────────────────────────────
// Dépenses
// ─────────────────────────────────────────────────────────────────────────

model Depense {
  id              String   @id @default(cuid())
  atelierId       String
  atelier         Atelier  @relation(fields: [atelierId], references: [id], onDelete: Restrict)
  categorie       String
  montant         Decimal  @db.Decimal(10, 2)
  date            DateTime @default(now())
  description     String?
  justificatifUrl String?
  createdAt       DateTime @default(now())

  // Annulation logique — mêmes principes que Paiement.annuleAt ci-dessus.
  annuleAt    DateTime?
  annuleMotif String?

  // atelierId : même correction de drift que Commande ci-dessus (index déjà
  // en base depuis la Phase 8, non déclaré jusqu'ici).
  @@index([atelierId])
  @@index([date])
  @@index([categorie])
}

// ─────────────────────────────────────────────────────────────────────────
// Stock (matières premières / fournitures — tissus, boutons, fil...)
// ─────────────────────────────────────────────────────────────────────────

enum UniteStock {
  METRE
  PIECE
  KG
  LITRE
  ROULEAU
  PAQUET
  AUTRE
}

enum TypeMouvementStock {
  ENTREE
  SORTIE
}

model ArticleStock {
  id           String     @id @default(cuid())
  atelierId    String
  atelier      Atelier    @relation(fields: [atelierId], references: [id], onDelete: Restrict)
  nom          String
  // Libre (comme Depense.categorie) plutôt qu'un enum : la variété de noms
  // de tissus/fournitures d'un atelier réel est trop large pour une liste fermée.
  categorie    String?
  unite        UniteStock @default(PIECE)
  // Pas de champ "quantite" ici : TOUJOURS dérivée de
  // SUM(mouvements ENTREE) - SUM(mouvements SORTIE), jamais stockée — même
  // principe que Commande.solde, dérivé des Paiements (voir
  // paiements.routes.js). Calculée à la lecture par lib/stock.js.
  seuilAlerte  Decimal?   @db.Decimal(10, 2)
  prixUnitaire Decimal?   @db.Decimal(10, 2)
  notes        String?
  archivedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  mouvements MouvementStock[]

  @@index([atelierId])
  @@index([nom])
}

model MouvementStock {
  id        String             @id @default(cuid())
  articleId String
  article   ArticleStock       @relation(fields: [articleId], references: [id], onDelete: Restrict)
  type      TypeMouvementStock
  // Toujours positive : le signe est déterminé par `type`, jamais encodé
  // dans la valeur (évite un ENTREE négatif ou une SORTIE positive incohérents).
  quantite  Decimal            @db.Decimal(10, 2)
  motif     String?
  createdAt DateTime           @default(now())

  @@index([articleId])
}

// ─────────────────────────────────────────────────────────────────────────
// Abonnement (Phase 6) — accès de l'atelier à la plateforme
// ─────────────────────────────────────────────────────────────────────────

/// Table de CONFIGURATION des formules — le prix se modifie ICI (table),
/// jamais en dur dans le code métier. Seedée avec 4 lignes à la migration,
/// prix TEMPORAIRES/À CONFIGURER (voir migration.sql). Une formule n'est
/// jamais supprimée après coup (Abonnement.formuleId la référence en
/// Restrict) : `actif=false` la retire des choix proposés sans casser
/// l'historique des abonnements déjà liés à elle.
model FormuleAbonnement {
  id        String   @id @default(cuid())
  dureeMois Int      @unique // 1, 3, 6 ou 12
  nom       String // "1 mois", "3 mois", "6 mois", "12 mois"
  prix      Decimal  @db.Decimal(10, 2) // TEMPORAIRE — voir migration.sql pour les valeurs de seed
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  abonnements Abonnement[]
}

model Abonnement {
  id             String             @id @default(cuid())
  atelierId      String
  atelier        Atelier            @relation(fields: [atelierId], references: [id], onDelete: Restrict)
  numero         String             @unique // ABN-2026-0001, même Counter que CMD/REC
  // Ancien modèle "formule = durée" (paiement en ligne, Phase 6) — optionnel
  // depuis l'activation manuelle par plan (planId ci-dessous).
  formuleId      String?
  formule        FormuleAbonnement? @relation(fields: [formuleId], references: [id], onDelete: Restrict)
  planId         String?
  plan           PlanAbonnement?    @relation(fields: [planId], references: [id], onDelete: Restrict)
  // Snapshots : le nom du plan et la durée au moment de l'activation ne
  // changent jamais rétroactivement si le plan est renommé ensuite.
  planNom        String?
  dureeMois      Int?
  creePar        String? // identifiant du SUPERADMIN qui a activé manuellement
  // Snapshot du prix de la formule AU MOMENT de la souscription — ne change
  // jamais rétroactivement si le tarif de la formule est ajusté ensuite
  // (même principe que Commande.prixTotal / Paiement.montant : un montant
  // déjà engagé n'est jamais recalculé après coup).
  prix           Decimal            @db.Decimal(10, 2)
  dateDebut      DateTime?
  dateExpiration DateTime?
  statut         StatutAbonnement   @default(EN_ATTENTE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  transactions Transaction[]
  historique   HistoriqueAbonnement[]

  @@index([atelierId])
  @@index([statut])
  @@index([formuleId])
  @@index([planId])
}

model Transaction {
  id                   String            @id @default(cuid())
  numero               String            @unique // TRX-2026-0001
  abonnementId         String
  abonnement           Abonnement        @relation(fields: [abonnementId], references: [id], onDelete: Restrict)
  moyenPaiement        MoyenPaiement
  montant              Decimal           @db.Decimal(10, 2)
  statut               StatutTransaction @default(EN_ATTENTE)
  // Notre clé d'idempotence — envoyée à Wave comme client_reference : permet
  // de retrouver la transaction depuis le webhook sans jamais en créer deux
  // pour un même paiement (rejeu webhook, double-clic sur "Payer"...).
  referenceInterne     String            @unique
  // Id de session Wave (cos-...), ou référence de transfert saisie
  // manuellement pour NITA/Amana (voir confirmeManuellement ci-dessous).
  referenceExterne     String?
  // true UNIQUEMENT pour NITA/Amana — jamais mis à true automatiquement,
  // seulement via une action explicite de l'admin (voir notifications.routes
  // équivalent pour abonnements : POST .../confirmer-manuellement).
  confirmeManuellement Boolean           @default(false)
  // Payload webhook Wave brut, conservé pour audit/litige — jamais
  // réinterprété après coup, juste une preuve horodatée de ce qui a été reçu.
  donneesBrutesWebhook Json?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([abonnementId])
}

/// Plans d'abonnement de la plateforme (Essentiel, Professionnel...) —
/// gérés par le SUPERADMIN. Le prix est mensuel ; la durée d'un abonnement
/// est choisie librement à l'activation (voir Abonnement.dureeMois).
model PlanAbonnement {
  id              String   @id @default(cuid())
  nom             String   @unique
  description     String?
  prixMensuel     Decimal  @db.Decimal(10, 2)
  fonctionnalites String[]
  ordre           Int      @default(0)
  actif           Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  abonnements Abonnement[]
}

model HistoriqueAbonnement {
  id             String           @id @default(cuid())
  atelierId      String
  atelier        Atelier          @relation(fields: [atelierId], references: [id], onDelete: Cascade)
  abonnementId   String?
  abonnement     Abonnement?      @relation(fields: [abonnementId], references: [id], onDelete: SetNull)
  action         ActionAbonnement
  planNom        String?
  dureeMois      Int?
  dateDebut      DateTime?
  dateExpiration DateTime?
  par            String? // identifiant du SUPERADMIN
  note           String?
  createdAt      DateTime         @default(now())

  @@index([atelierId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Compteurs atomiques (numérotation CMD-AAAA-XXXX / REC-AAAA-XXXX)
// id = "CMD-2026", "REC-2026", etc. — un compteur par préfixe ET par année,
// donc la numérotation repart proprement à 0001 chaque nouvelle année.
// ─────────────────────────────────────────────────────────────────────────

model Counter {
  id     String @id
  valeur Int    @default(0)
}

// Rate-limiting persistant (Postgres) — express-rate-limit (mémoire locale
// du process) ne suffit pas en environnement serverless (Vercel) :
// plusieurs instances de fonction traitent les requêtes en parallèle,
// chacune avec son propre compteur en mémoire, ce qui permettrait de
// dépasser largement la limite annoncée (ex: 10 tentatives/15min sur
// /login pourrait en réalité en autoriser bien plus, réparties sur
// plusieurs instances). Une seule ligne par clé (préfixe de route + IP),
// partagée par toutes les instances via la base — voir lib/rateLimiter.js.
model LimiteTaux {
  id           String   @id @default(cuid())
  cle          String   @unique
  fenetreDebut DateTime @default(now())
  compte       Int      @default(1)
  updatedAt    DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// Journal d'impersonation (§ SUPERADMIN "se connecter en tant que")
// ─────────────────────────────────────────────────────────────────────────

// Trace chaque impersonation déclenchée par un SUPERADMIN (voir
// atelierProvisioning.js:demarrerImpersonation). DÉLIBÉRÉMENT sans relation
// Prisma vers User/Atelier (contrairement à la convention onDelete: Restrict
// du reste du schéma) : un journal d'audit doit rester lisible et complet
// même après suppression du compte concerné (voir DELETE
// /:id/comptes/:userId, ateliers.routes.js — un compte PEUT être supprimé),
// ce qu'un onDelete: Restrict interdirait à vie et qu'un onDelete: Cascade/
// SetNull corromprait (perte de la trace). Les libellés sont donc capturés
// en instantané au moment de l'action, comme Abonnement.prix pour
// FormuleAbonnement.
model JournalImpersonation {
  id                    String   @id @default(cuid())
  superadminId          String
  superadminIdentifiant String
  atelierId             String
  atelierNom            String
  adminUserId           String
  adminIdentifiant      String
  demarreLe             DateTime @default(now())

  @@index([atelierId])
  @@index([superadminId])
}
