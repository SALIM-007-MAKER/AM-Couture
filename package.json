{
  "name": "gestion-atelier",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "node --experimental-strip-types --env-file=.env prisma/seed.js",
    "prisma:seed:superadmin": "node --experimental-strip-types --env-file=.env prisma/seedSuperadmin.js",
    "build": "npm run build -w frontend",
    "test": "npm run test -w backend"
  },
  "devDependencies": {
    "prisma": "^7.10.0",
    "dotenv": "^17.2.3"
  },
  "overrides": {
    "mysql2": "^3.24.4",
    "deepmerge-ts": "^8.0.2"
  }
}
